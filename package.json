{
  "name": "fe-kit",
  "version": "1.38.1",
  "private": true,
  "description": "Architecture ownership, reuse-first authoring, and React performance checks before non-trivial frontend work.",
  "license": "MIT",
  "omp": {
    "extensions": [
      "./extensions/fe-gate.ts"
    ]
  },
  "dependencies": {
    "fast-check": "^4.11.0",
    "fast-json-stable-stringify": "^2.1.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@types/bun": "^1.4.5",
    "eslint": "^10.15.0",
    "typescript-eslint": "^8.73.0"
  },
  "scripts": {
    "test": "bun test extensions/checkout",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "lint": "bunx eslint extensions/checkout --max-warnings 0",
    "mutate": "bunx stryker run",
    "gates": "bun run typecheck && bun run lint && bun run test && bun run mutate"
  }
}
